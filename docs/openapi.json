{
  "openapi": "3.0.3",
  "info": {
    "title": "APRSNETCN SERVER 台站接口",
    "version": "0.1.0",
    "description": "APRSNETCN SERVER 保存最近 24 小时收到的台站位置，用这份接口读出来。任何客户端都能调，不限于 APRSLocus。"
  },
  "servers": [
    {
      "url": "/",
      "description": "当前实例"
    }
  ],
  "tags": [
    {
      "name": "auth"
    },
    {
      "name": "stations"
    },
    {
      "name": "meta"
    },
    {
      "name": "public",
      "description": "不用 token 的公开接口与页面"
    },
    {
      "name": "sync",
      "description": "个人数据同步：消息 / 云端备份 / 历史轨迹（长期令牌）"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "admin": {
        "type": "apiKey",
        "in": "header",
        "name": "X-ACN-Token",
        "description": "管理口令"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "account",
          "password"
        ],
        "properties": {
          "account": {
            "type": "string",
            "example": "bg7lzq"
          },
          "password": {
            "type": "string",
            "example": "……"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "token": {
            "type": "string"
          },
          "call": {
            "type": "string",
            "example": "BG7LZQ"
          },
          "expires": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Symbol": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "example": "/"
          },
          "code": {
            "type": "string",
            "example": ">"
          }
        }
      },
      "Station": {
        "type": "object",
        "properties": {
          "call": {
            "type": "string",
            "example": "BG7LZQ-9"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time"
          },
          "lat": {
            "type": "number",
            "example": 39.9
          },
          "lon": {
            "type": "number",
            "example": 116.383
          },
          "symbol": {
            "$ref": "#/components/schemas/Symbol"
          },
          "speed": {
            "type": "number",
            "nullable": true
          },
          "course": {
            "type": "number",
            "nullable": true
          },
          "alt": {
            "type": "number",
            "nullable": true
          },
          "comment": {
            "type": "string"
          },
          "via": {
            "type": "string",
            "enum": [
              "rf",
              "is"
            ]
          },
          "packets": {
            "type": "integer"
          }
        }
      },
      "TrackPoint": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "speed": {
            "type": "number",
            "nullable": true
          },
          "course": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "StationDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Station"
          },
          {
            "type": "object",
            "properties": {
              "first_seen": {
                "type": "string",
                "format": "date-time"
              },
              "track": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TrackPoint"
                }
              }
            }
          }
        ]
      },
      "StationList": {
        "type": "object",
        "properties": {
          "window": {
            "type": "string",
            "example": "24h"
          },
          "updated": {
            "type": "string",
            "format": "date-time"
          },
          "count": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "description": "窗口内的台站总数，配合 offset 分页用"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "stations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Station"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "server": {
            "type": "string"
          },
          "proto": {
            "type": "string"
          },
          "uptime": {
            "type": "integer"
          },
          "clients": {
            "type": "integer"
          },
          "packets_in": {
            "type": "integer"
          },
          "packets_out": {
            "type": "integer"
          },
          "stations_24h": {
            "type": "integer"
          },
          "positions_24h": {
            "type": "integer"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "whitelist_version": {
            "type": "integer",
            "description": "本地名单版本号"
          },
          "whitelist_synced_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "最近一次名单同步时间，没同步过是 null"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "unauthorized"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "账号密码换 token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "拿到 token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "账号或密码不对"
          },
          "403": {
            "description": "名单里没有或授权失效"
          }
        }
      }
    },
    "/api/v1/stations": {
      "get": {
        "tags": [
          "stations"
        ],
        "summary": "最近 24 小时的台站列表",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "window",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "24h"
            },
            "description": "时间窗口，最多到服务器保留时长（默认 24h）"
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "只要这个时刻之后的报文，ISO 8601"
          },
          {
            "name": "bbox",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "minlat,minlon,maxlat,maxlon"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 500,
              "maximum": 5000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "台站列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationList"
                }
              }
            }
          },
          "401": {
            "description": "没有 token 或已过期"
          },
          "429": {
            "description": "请求太密"
          }
        }
      }
    },
    "/api/v1/stations/{call}": {
      "get": {
        "tags": [
          "stations"
        ],
        "summary": "单台站与 24 小时轨迹",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "call",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "台站",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationDetail"
                }
              }
            }
          },
          "404": {
            "description": "24 小时内没有这台站"
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "运行状态，不用鉴权",
        "responses": {
          "200": {
            "description": "状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "协议版本与服务器实际策略",
        "responses": {
          "200": {
            "description": "版本信息"
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "这份文档本身",
        "responses": {
          "200": {
            "description": "OpenAPI 3"
          }
        }
      }
    },
    "/api/public/stations": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "24 小时台站，不用 token（按来源 IP 限流，默认不对外）",
        "parameters": [
          {
            "name": "window",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "24h"
            }
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 5000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "台站列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stations"
                }
              }
            }
          },
          "403": {
            "description": "台站数据没对外开（ACN_PUBLIC_API=0）"
          },
          "429": {
            "description": "同一个 IP 请求太密"
          }
        }
      }
    },
    "/api/public/stations/{call}": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "单台站与 24 小时轨迹，不用 token（默认不对外）",
        "parameters": [
          {
            "name": "call",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "台站",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Station"
                }
              }
            }
          },
          "403": {
            "description": "台站数据没对外开（ACN_PUBLIC_API=0）"
          },
          "404": {
            "description": "24 小时里没有这台站"
          },
          "429": {
            "description": "同一个 IP 请求太密"
          }
        }
      }
    },
    "/stations": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "台站页（地图上点选台站，默认不对外）",
        "responses": {
          "200": {
            "description": "HTML 页面"
          },
          "403": {
            "description": "台站数据没对外开（ACN_PUBLIC_API=0）"
          }
        }
      }
    },
    "/api/v1/sync/login": {
      "post": {
        "tags": [
          "sync"
        ],
        "summary": "名单账号换长期同步令牌，并记下这台设备",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "account",
                  "password"
                ],
                "properties": {
                  "account": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "device": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "客户端安装标识（随机生成一次，存在本机）"
                      },
                      "ver": {
                        "type": "string"
                      },
                      "platform": {
                        "type": "string"
                      },
                      "abi": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "令牌、呼号、设备指纹与到期时间"
          },
          "401": {
            "description": "账号或口令不对"
          },
          "403": {
            "description": "名单里没有，或已过期/暂停/撤销"
          }
        }
      }
    },
    "/api/v1/sync/logout": {
      "post": {
        "tags": [
          "sync"
        ],
        "summary": "作废当前这个令牌",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "已作废"
          },
          "401": {
            "description": "没有令牌或令牌已过期/被撤"
          },
          "403": {
            "description": "这台服务器没开同步"
          },
          "429": {
            "description": "请求太密"
          }
        }
      }
    },
    "/api/v1/sync/state": {
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "云端有什么：设备、消息条数、轨迹天数、备份列表",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "同步情况"
          },
          "401": {
            "description": "没有令牌或令牌已过期/被撤"
          },
          "403": {
            "description": "这台服务器没开同步"
          },
          "429": {
            "description": "请求太密"
          }
        }
      }
    },
    "/api/v1/sync/messages": {
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "增量拉消息",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "只要这个毫秒时间戳之后的"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 500
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "消息列表"
          },
          "401": {
            "description": "没有令牌或令牌已过期/被撤"
          },
          "403": {
            "description": "这台服务器没开同步"
          },
          "429": {
            "description": "请求太密"
          }
        }
      },
      "post": {
        "tags": [
          "sync"
        ],
        "summary": "增量推消息（按 mid 并集）",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "mid",
                        "ts"
                      ],
                      "properties": {
                        "mid": {
                          "type": "string"
                        },
                        "ts": {
                          "type": "integer"
                        },
                        "peer": {
                          "type": "string"
                        },
                        "dir": {
                          "type": "string",
                          "enum": [
                            "in",
                            "out"
                          ]
                        },
                        "text": {
                          "type": "string"
                        },
                        "acked": {
                          "type": "boolean"
                        },
                        "grp": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新增条数与总数"
          },
          "401": {
            "description": "没有令牌或令牌已过期/被撤"
          },
          "403": {
            "description": "这台服务器没开同步"
          },
          "429": {
            "description": "请求太密"
          }
        }
      }
    },
    "/api/v1/sync/tracks": {
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "这人的全部轨迹天：点数、设备数、更新时间",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "按天列出"
          },
          "401": {
            "description": "没有令牌或令牌已过期/被撤"
          },
          "403": {
            "description": "这台服务器没开同步"
          },
          "429": {
            "description": "请求太密"
          }
        }
      }
    },
    "/api/v1/sync/tracks/{day}": {
      "parameters": [
        {
          "name": "day",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "本地日期 YYYY-MM-DD"
        },
        {
          "name": "device",
          "in": "query",
          "schema": {
            "type": "string"
          },
          "description": "只读写这一台设备的那一天；不带就是多台合起来"
        }
      ],
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "拉一天的轨迹点（默认多设备合并去重）",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "那天的点"
          },
          "401": {
            "description": "没有令牌或令牌已过期/被撤"
          },
          "403": {
            "description": "这台服务器没开同步"
          },
          "429": {
            "description": "请求太密"
          },
          "404": {
            "description": "那天没有数据"
          }
        }
      },
      "put": {
        "tags": [
          "sync"
        ],
        "summary": "上传一天（写进当前令牌对应的这台设备）",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "t",
                        "lat",
                        "lng"
                      ],
                      "properties": {
                        "t": {
                          "type": "integer"
                        },
                        "lat": {
                          "type": "number"
                        },
                        "lng": {
                          "type": "number"
                        },
                        "v": {
                          "type": "number"
                        },
                        "c": {
                          "type": "number"
                        },
                        "a": {
                          "type": "number"
                        },
                        "acc": {
                          "type": "number"
                        },
                        "hr": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "并集后的点数"
          },
          "401": {
            "description": "没有令牌或令牌已过期/被撤"
          },
          "403": {
            "description": "这台服务器没开同步"
          },
          "429": {
            "description": "请求太密"
          }
        }
      },
      "delete": {
        "tags": [
          "sync"
        ],
        "summary": "删一天的轨迹",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "删掉的条数"
          },
          "401": {
            "description": "没有令牌或令牌已过期/被撤"
          },
          "403": {
            "description": "这台服务器没开同步"
          },
          "429": {
            "description": "请求太密"
          }
        }
      }
    },
    "/api/v1/sync/backup": {
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "云端备份列表",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "每人最多三份"
          },
          "401": {
            "description": "没有令牌或令牌已过期/被撤"
          },
          "403": {
            "description": "这台服务器没开同步"
          },
          "429": {
            "description": "请求太密"
          }
        }
      },
      "put": {
        "tags": [
          "sync"
        ],
