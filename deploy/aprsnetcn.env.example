# APRSNETCN SERVER 运行参数。改完 systemctl restart aprsnetcn
# 放到 /etc/aprsnetcn.env，权限 600。

# 数据目录，数据库落在 $ACN_DATA_DIR/aprsnetcn.db
ACN_DATA_DIR=/var/lib/aprsnetcn

# 客户端接入
ACN_TCP_HOST=0.0.0.0
ACN_TCP_PORT=14580
ACN_SERVER_ID=APRSNETCN

# TLS 端口，不填就是不开
ACN_TCP_PORT_TLS=0
ACN_TLS_CERT=
ACN_TLS_KEY=

# compat：passcode 不对只给收；strict：必须对；off：只看名单
ACN_PASSCODE_MODE=compat

# 登录呼号与报文源呼号不一致：allow / warn / reject
ACN_SRC_POLICY=warn

# 转发时补 qAC,登录呼号（与 APRS-IS 一致）
ACN_ADD_Q_CONSTRUCT=1

# 上限
ACN_MAX_CONN=120
ACN_MAX_LINE=512
ACN_LOGIN_TIMEOUT=30
ACN_QUEUE_LIMIT=128
ACN_RATE_LINES=60
ACN_RATE_WINDOW=10

# 24 小时台站
ACN_RETENTION_HOURS=24
ACN_PURGE_SECONDS=60

# HTTP 接口与管理控制台
ACN_HTTP_HOST=0.0.0.0
ACN_HTTP_PORT=8899
ACN_PUBLIC_URL=http://8.138.199.11:8899

# 管理控制台口令，空 = 关掉控制台
ACN_ADMIN_PASSWORD=

# 名单同步密钥（MANAGER → SERVER），空 = 关掉同步接口
ACN_MANAGER_SECRET=

# token 有效期（秒）与每 token 每分钟请求上限
ACN_TOKEN_TTL=43200
ACN_API_RATE_MINUTE=120

# 第一次启动时的引导授权，库里已有名单就忽略
ACN_BOOTSTRAP_CALL=
ACN_BOOTSTRAP_ACCOUNT=
ACN_BOOTSTRAP_PASSWORD=

# 外部数据：只读拉一份 APRS-IS（默认关）
ACN_INGEST_ENABLED=0
ACN_INGEST_HOST=rotate.aprs2.net
ACN_INGEST_PORT=14580
ACN_INGEST_LOGIN=BG7LZQ
ACN_INGEST_FILTER=r/35/105/2000
ACN_INGEST_FORWARD=0
